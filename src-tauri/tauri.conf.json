{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noctune",
  "version": "4.4.2",
  "identifier": "dev.noctune.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=frontend",
    "beforeBuildCommand": "npm run build --workspace=frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noctune",
        "width": 980,
        "height": 620,
        "minWidth": 780,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/noctune-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../CHANGELOG.md",
      "../backend/src/data/seed-model.json",
      "resources/yt-dlp.exe",
      "resources/innertube.exe"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxRDg5MzYzQ0Y4ODNCRQpSV1MrZy9nOE5va2RBOHRJNXZrSC9mMVIwSlVta0VxbmRxSC9xYTBsUGwwUGZ3SmpSZlBFangxUAo=",
      "endpoints": [
        "https://github.com/caya8205-2/noctune/releases/latest/download/latest.json"
      ]
    }
  }
}
