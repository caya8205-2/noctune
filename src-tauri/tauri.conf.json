{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noctune",
  "version": "0.1.0",
  "identifier": "dev.noctune.app",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=frontend",
    "beforeBuildCommand": "npm run build --workspace=frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noctune",
        "width": 980,
        "height": 620,
        "minWidth": 780,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
