{
  "name": "@noctune/backend",
  "version": "2.1.0",
  "private": true,
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:matcher": "tsx test/matcherFixture.ts",
    "build:binary": "pkg . --target node24-win-x64 --output ../src-tauri/binaries/noctune-backend-x86_64-pc-windows-msvc.exe"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [
      "../node_modules/better-sqlite3/prebuilds/**/*",
      "../node_modules/better-sqlite3/build/Release/**/*.node",
      "../node_modules/kuromoji/dict/**/*",
      "../node_modules/youtubei.js/package.json",
      "../node_modules/youtubei.js/bundle/browser.js",
      "../node_modules/music-metadata/**/*",
      "../node_modules/strtok3/**/*",
      "../node_modules/token-types/**/*",
      "../node_modules/peek-readable/**/*",
      "../node_modules/file-type/**/*"
    ]
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "better-sqlite3": "^11.3.0",
    "discord-rpc": "^4.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "fluent-ffmpeg": "^2.1.3",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "music-metadata": "^11.13.0",
    "node-cache": "^5.1.2",
    "p-queue": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "youtubei.js": "^17.0.1",
    "yt-dlp-wrap": "^2.3.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^22.0.0",
    "@yao-pkg/pkg": "^6.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
